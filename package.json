{
  "name": "rokko",
  "private": true,
  "version": "0.1.0-alpha.3",
  "description": "Rokko — Linux-first local workspace for web apps",
  "main": "./out/main/index.js",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/linux/dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*/*.test.mjs",
    "package:linux": "pnpm build && node scripts/release/package-linux.mjs",
    "dev:raw": "electron-vite dev",
    "linux:doctor": "node scripts/linux/dev.mjs --doctor",
    "linux:setup": "node scripts/linux/dev.mjs --setup",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "release:verify": "node scripts/release/verify.mjs",
    "smoke:linux": "node scripts/release/smoke-linux.mjs",
    "smoke:prepare": "node scripts/release/prepare-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "build": {
    "appId": "dev.rokko.desktop",
    "productName": "Rokko",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "executableName": "rokko",
      "icon": "assets/brand/rokko-dark-icon.png",
      "syncDesktopName": true
    },
    "directories": {
      "output": "dist"
    },
    "deb": {
      "appArmorProfile": "build/linux/apparmor-profile"
    },
    "artifactName": "${name}-${version}-linux-${arch}.${ext}",
    "afterPack": "build/hooks/after-pack.cjs",
    "appImage": {
      "executableArgs": []
    }
  },
  "packageManager": "pnpm@12.4.1",
  "desktopName": "dev.rokko.desktop"
}
