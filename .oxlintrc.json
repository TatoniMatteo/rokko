{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": { "correctness": "error" },
  // External icon/menu events reset local state; keyboard-first pages intentionally focus controls.
  // Explicit ARIA roles keep status regions and dock groups without changing their native layout.
  "rules": {
    "react/set-state-in-effect": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "env": { "browser": true, "node": true },
  "ignorePatterns": ["node_modules/", "out/", "dist/", ".codex/"]
}
