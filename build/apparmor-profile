# Rokko DEB installation: allow Chromium to create a user namespace on Ubuntu 24+.
# This is an unconfined AppArmor identity with userns permission, NOT a full confinement policy.
abi <abi/4.0>,
include <tunables/global>
profile "${executable}" "/opt/${sanitizedProductName}/${executable}" flags=(unconfined) {
  userns,
}
